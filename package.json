    "babel-loader": "^8.2.5",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.7.1",
    "fast-xml-parser": "^5.3.2",
    "fork-ts-checker-webpack-plugin": "~7.3.0",
    "glob": "^8.0.3",
    "globby": "^16.0.0",
    "html-webpack-plugin": "~5.5.0",
    "less": "^4.4.2",
    "less-loader": "^12.3.0",
